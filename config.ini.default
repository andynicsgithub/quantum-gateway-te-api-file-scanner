# This is config.ini.default v11.2 (alpha)
[DEFAULT]
#Directories - where the files are starting from and which directories they should be moved to when benign or malicious or causing an error etc.
input_directory = /path/to/source/files
reports_directory = /path/to/directory/for/report/files
appliance_ip = 192.168.1.1
benign_directory = /path/to/directory/for/safe/files
quarantine_directory = /path/to/quarantine
error_directory = /path/to/directory/for/files/that/error
#Directory to store the archive of the files processed, and the password to be used in the zip file.
zip_archive_directory = /path/to/directory/for/zip/archives
zip_password =
#How many files to process at once.
concurrency = 4
#How long to wait between queries to get the verdict. Recommended between 5 and 15. Ensure that seconds_to_wait multiplied by max_retries is 5 minutes or more.
seconds_to_wait = 10
max_retries = 120

[WATCHER]
# Watch mode settings (used when running with --watch flag)
# Wait time in seconds after last file activity before processing batch. Must be 1 or greater.
watch_batch_delay = 5

# Minimum files to trigger batch (0 = process immediately after delay)
watch_min_batch = 0

# Maximum batch size (0 = unlimited)
watch_max_batch = 0

[EMAIL]
# Email notification settings (sent after each batch completes in watch mode)
# Set enabled=true to activate notifications
email_enabled = false

# SMTP settings
email_smtp_server = 
email_smtp_port = 587
email_use_tls = true
email_skip_tls_verify = false
email_username = 
email_password = 
email_from = 
email_to = 

# Subject template (supports ${timestamp}, ${appliance_ip}, ${processed}, ${malicious})
email_subject_template = TE Scanner: ${processed} files processed - ${malicious} malicious

# Body template file path (string.Template format with placeholders)
# Available placeholders: ${timestamp}, ${appliance_ip}, ${processed}, ${benign},
#   ${malicious}, ${error}, ${file_list}, ${malicious_files}, ${smtp_server}
# Include ${file_list} in template to show detailed file listing
email_template_file = data/email_template.txt

# IMAP "Sent" folder settings (separate from SMTP credentials)
# Set enabled=true to save sent emails to an IMAP folder
email_imap_enabled = false
email_imap_server = 
email_imap_port = 993
email_imap_use_ssl = true
email_imap_username = 
email_imap_password = 
email_imap_folder = Sent

[LOGGING]
log_level = INFO
log_dir = ./logs
max_log_size_mb = 10
backup_count = 5

[TEX]
tex_enabled = false
tex_url =
tex_api_key =
tex_response_info_directory = tex_response_info
tex_clean_files_directory = tex_clean_files

[TEX_SUPPORTED_FILE_TYPES]
# File types (extensions) to send to TEX API for scrubbing
# Files with extensions not listed here will be skipped from TEX processing
# Empty section or missing entry = skip that file type
bmp = true
dcm = true
dib = true
doc = true
docm = true
docx = true
dot = true
dotm = true
dotx = true
eps = true
fdf = true
gif = true
html = true
hwp = true
jfif = true
jpe = true
jpeg = true
jpg = true
js = true
jtd = true
mht = true
mpo = true
pcx = true
pdf = true
png = true
pot = true
potm = true
potx = true
ppam = true
pps = true
ppsm = true
ppsx = true
ppt = true
pptm = true
pptx = true
psd = true
rtf = true
tga = true
tif = true
tiff = true
txt = true
xlam = true
xls = true
xlsb = true
xlsm = true
xlsx = true
xltm = true
xltx = true
xml = true

[TEX_SCRUBBED_PARTS]
# Scrubbed parts codes to include in TEX scrub request
# Each entry enables that content part for scrubbing
# Disabled entries (false) are excluded from the scrub request
1017 = true   # Custom Properties
1018 = true   # Database Queries
1019 = true   # Embedded Objects
1021 = true   # Fast Save Data
1025 = true   # Linked Objects
1026 = true   # Macros and Code
1034 = true   # Sensitive Hyperlinks
1036 = true   # Statistic Properties
1037 = true   # Summary Properties
1137 = true   # PDF GoToR Actions
1139 = true   # PDF Launch Actions
1141 = true   # PDF URI Actions
1142 = true   # PDF Sound Actions
1143 = true   # PDF Movie Actions
1150 = true   # PDF JavaScript Actions
1151 = true   # PDF Submit Form Actions
1178 = true   # PDF 3D Artwork Annotations
500 = true    # Embedded Images
