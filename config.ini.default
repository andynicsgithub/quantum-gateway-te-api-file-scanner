  # This is config.ini.default v13.1 (alpha)
[DEFAULT]
#Directories - where the files are starting from and which directories they should be moved to when benign or malicious or causing an error etc.
input_directory = /path/to/source/files
reports_directory = /path/to/directory/for/report/files
appliance_ip = 192.168.1.1
appliance_skip_tls_verify = false
benign_directory = /path/to/directory/for/safe/files
quarantine_directory = /path/to/quarantine
error_directory = /path/to/directory/for/files/that/error

#Directory to store the archive of the files processed, and the password to be used in the zip file.
zip_archive_directory = /path/to/directory/for/zip/archives
zip_password =

#How to process files - how many can the appliance handle at once, how long to wait between queries, how many times to query before giving up.
concurrency = 4
seconds_to_wait = 10
max_retries = 120



[ARCHIVE_FILE_TYPES]
# Defines the list of supported file types that are archives.
# Archives are processed one-by-one (sequentially) rather than in parallel.
7z = true
arj = true
bz2 = true
cab = true
dmg = true
gz = true
img = true
iso = true
msi = true
pkg = true
rar = true
tar = true
tbz2 = true
tbz = true
tb2 = true
tgz = true
xz = true
zip = true
udf = true
qcow2 = true



[WATCHER]
# Watch mode settings (used when running with --watch flag)
# Wait time in seconds after last file activity before processing batch. Must be between 1 and 60.
watch_batch_delay = 5

# Maximum batch size (0 = unlimited)
watch_max_batch = 0



[EMAIL]
# Email notification settings (sent after each batch completes in watch mode)
# Set enabled=true to activate notifications
email_enabled = false

# Send email only when malicious files are found (default: false = every batch)
email_malicious_only = false

# SMTP settings
email_smtp_server =
# none | starttls | smtp_ssl
# none: no encryption (local/internal mail servers only)
# starttls: upgrade connection with STARTTLS after connect (port 587)
# smtp_ssl: implicit SSL from connection start (port 465)
email_tls_method = starttls
# Must set the port number in all cases. Set to default port as listed in the comments just above, or set to a custom port to override the default for the chosen protocol.
email_smtp_port = 587

email_skip_tls_verify = false
email_username = 
email_password = 
email_from = 
email_to = 

# Subject template (supports ${timestamp}, ${appliance_ip}, ${processed}, ${malicious})
email_subject_template = TE Scanner: ${processed} files processed - ${malicious} malicious

# Body template file path (string.Template format with placeholders)
# Available placeholders: ${timestamp}, ${appliance_ip}, ${processed}, ${benign},
#   ${malicious}, ${error}, ${file_list}, ${malicious_files}, ${smtp_server}
# Include ${file_list} in template to show detailed file listing
email_template_file = data/email_template.txt

# Attach today's log file to the notification email
email_include_log = true

# IMAP "Sent" folder settings (separate from SMTP credentials)
# Set enabled=true to save sent emails to an IMAP folder
email_imap_enabled = false
email_imap_server = 
email_imap_port = 993
email_imap_use_ssl = true
email_imap_username = 
email_imap_password = 
email_imap_folder = Sent
email_imap_skip_tls_verify = false



[OS_IMAGES]
# OS image selection for TE sandbox analysis.
# Set each image to true to include it in analysis, false to exclude.
# If no images are enabled or this section is omitted, the API server uses its own default images.
#
e50e99f3-5963-4573-af9e-e3f4750b55e2 = true    # WinXP 32b, Office 2003/7, Acrobat 9.0 [DEFAULT]
7e6fe36e-889e-4c25-8704-56378f0830df = false   # Win7 32b, Office 2003/7, Acrobat 9.0
8d188031-1010-4466-828b-0cd13d4303ff = false   # Win7 32b, Office 2010, Acrobat 9.4
5e5de275-a103-4f67-b55b-47532918fa59 = true    # Win7 32b, Office 2013, Acrobat 11.0 [DEFAULT]
3ff3ddae-e7fd-4969-818c-d5f1a2be336d = false   # Win7 64b, Office 2010, Acrobat 11.0.01
6c453c9b-20f7-471a-956c-3198a868dc92 = false   # Win8.1 64b, Office 2013, Acrobat 11.0.10
10b4a9c6-e414-425c-ae8b-fe4dd7b2524e = false   # Win10 64b, Office 2016, Acrobat DC 2015
1108f8e1-2def-457d-901b-056d954c47fc = false   # Win11 64bit, Office 2021, Acrobat DC



[TEX]
tex_enabled = false
tex_url =
tex_api_key =
tex_response_info_directory = tex_response_info
tex_clean_files_directory = tex_clean_files



[TEX_SUPPORTED_FILE_TYPES]
# File types (extensions) to send to TEX API for scrubbing
# Files with extensions not listed here will be skipped from TEX processing
# Empty section or missing entry = skip all file types from TEX processing
bmp = true
dcm = true
dib = true
doc = true
docm = true
docx = true
dot = true
dotm = true
dotx = true
eps = true
fdf = true
gif = true
html = true
hwp = true
jfif = true
jpe = true
jpeg = true
jpg = true
js = true
jtd = true
mht = true
mpo = true
pcx = true
pdf = true
png = true
pot = true
potm = true
potx = true
ppam = true
pps = true
ppsm = true
ppsx = true
ppt = true
pptm = true
pptx = true
psd = true
rtf = true
tga = true
tif = true
tiff = true
txt = true
xlam = true
xls = true
xlsb = true
xlsm = true
xlsx = true
xltm = true
xltx = true
xml = true



[TEX_SCRUBBED_PARTS]
# Scrubbed parts codes to include in TEX scrub request
# Missing section or entirely commented out = use hardcoded defaults
# All entries set to false (or empty section) = skip scrubbing entirely for this file
# Mixed true/false = only enabled codes are sent to the API
1017 = false   # Custom Properties
1018 = true   # Database Queries
1019 = true   # Embedded Objects
1021 = true   # Fast Save Data
1025 = true   # Linked Objects
1026 = true   # Macros and Code
1034 = true   # Sensitive Hyperlinks
1036 = false   # Statistic Properties
1037 = false   # Summary Properties
1137 = true   # PDF GoToR Actions
1139 = true   # PDF Launch Actions
1141 = true   # PDF URI Actions
1142 = true   # PDF Sound Actions
1143 = true   # PDF Movie Actions
1150 = true   # PDF JavaScript Actions
1151 = true   # PDF Submit Form Actions
1178 = false   # PDF 3D Artwork Annotations
500 = false    # Embedded Images



[AV_FALLBACK]
# Antivirus fallback for files too large for TE (>= 100MB) or unsupported by TE.
# Uses SFTP to transfer files and SSH to trigger analysis on the appliance.
# IMPORTANT: ssh_password is stored in plaintext. Use environment variables
# (TE_SSH_PASSWORD) for sensitive deployments.
# av_te_threshold_mb - files >= this value skip TE and go to AV.
# Increase if your TE appliance handles larger files better. Default: 100.

av_fallback_enabled = false
ssh_username = apiclient
ssh_password =
av_remote_directory = /var/log/apiclient
av_rule_id = 1
av_te_threshold_mb = 100

[HEALTHCHECK]
# Health check test files directory (relative to app directory).
# Contains test_clean.pdf (TE test) and test_clean.docx (AV test).
# The tool uploads test_clean.pdf to the TE API to verify end-to-end functionality.
# If AV fallback is enabled, test_clean.docx is transferred via SFTP and analyzed.
# A correct health check requires the test file to return "Malicious".
directory = healthcheck

[LOGGING]
log_level = INFO
log_dir = ./logs
max_log_size_mb = 10
log_retention_days = 90

# Save API response transcripts to reports_directory (TE + TEX). Set to false to disable.
save_response_info = true
